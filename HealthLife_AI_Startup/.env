# Copy this file to ".env" and fill in values. NEVER commit ".env".
# Optional: an administrator can instead save the key in the app under Admin -> AI settings.
GROQ_API_KEY=your_groq_api_key_here
# Model name is configurable; use any model your OpenAI account can access.
GROQ_MODEL=openai/gpt-oss-120b
# Random string for signing sessions (auto-generated into .secret_key if empty).
HEALTHLIFE_SECRET_KEY=
# Set to 1 when served over HTTPS so cookies are marked Secure.
HEALTHLIFE_HTTPS=0
# Set to 0 in production.
HEALTHLIFE_DEBUG=1
